#!/usr/bin/env bash
set -uo pipefail

MSG_FILE="$1"
TYPES="feat|fix|refactor|chore|docs|dev|agents|perf|style|test|ci|build"

mapfile -t LINES < <(grep -v '^#' "$MSG_FILE")
SUBJECT="${LINES[0]:-}"

case "$SUBJECT" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

fail() {
  echo "commit-msg: $1" >&2
  echo >&2
  echo "  The format, from this repository's own history:" >&2
  echo >&2
  echo "    type(scope): lowercase summary" >&2
  echo >&2
  echo "    - Bullet naming one change, ending with a full stop." >&2
  echo "    - One bullet per change, with the symbol or file named inline." >&2
  echo >&2
  echo "  Types: feat, fix, refactor, chore, docs, dev, agents, perf, style, test, ci, build." >&2
  echo "  A body is optional. When there is one it is bullets, not prose." >&2
  echo "  Bypass once with: git commit --no-verify" >&2
  exit 1
}

[[ -n "$SUBJECT" ]] || fail "the message is empty"

if ! [[ "$SUBJECT" =~ ^($TYPES)(\([a-z0-9./-]+\))?:\ [a-z] ]]; then
  fail "the subject is not \"type(scope): lowercase summary\": $SUBJECT"
fi

if (( ${#LINES[@]} > 1 )) && [[ -n "${LINES[1]:-}" ]]; then
  fail "the subject and the body need a blank line between them"
fi

for (( i = 2; i < ${#LINES[@]}; i++ )); do
  line="${LINES[$i]}"
  [[ -z "$line" ]] && continue
  [[ "$line" =~ ^[A-Za-z-]+:\ .*$ ]] && continue
  [[ "$line" =~ ^\ \ +[^-] ]] && continue
  if ! [[ "$line" =~ ^-\ [^[:space:]] ]]; then
    fail "a body line is not a bullet starting \"- \": $line"
  fi
  if ! [[ "$line" =~ [.:]$ ]]; then
    fail "a bullet does not end with a full stop: $line"
  fi
done

exit 0
