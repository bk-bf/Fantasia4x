{
  "name": "fantasia4x",
  "private": true,
  "version": "0.1.247",
  "license": "AGPL-3.0-or-later",
  "description": "Fantasia4x \u2014 a turn-based 4X colony chronicle.",
  "author": "bk",
  "type": "module",
  "main": "electron/main.cjs",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "vite dev --host",
    "build": "vite build",
    "tools:pack": "node scripts/dev-tools/pack.mjs",
    "preview": "vite preview",
    "electron": "electron .",
    "package": "electron-builder",
    "package:dir": "electron-builder --dir",
    "dist": "pnpm build && electron-builder",
    "test": "vitest run",
    "test:changed": "vitest run --changed",
    "test:related": "vitest related --run",
    "test:watch": "vitest",
    "check": "pnpm check:types && pnpm lint && pnpm knip",
    "lint": "eslint . --max-warnings 221",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "audit": "node tools/audit/audit.mjs",
    "audit:index": "node tools/audit/audit.mjs index && node tools/audit/audit.mjs plan",
    "audit:status": "node tools/audit/audit.mjs status",
    "audit:t0": "node tools/audit/audit.mjs t0",
    "audit:run": "node tools/audit/run.mjs",
    "add:wasm": "cd spatial-core && ~/.cargo/bin/wasm-pack build --target web --out-dir ../src/lib/spatial-core-pkg",
    "add:wasm:sim": "cd sim-core && ~/.cargo/bin/wasm-pack build --target web --out-dir ../src/lib/sim-core-pkg",
    "test:sim-core": "cd sim-core && cargo test",
    "threat": "node scripts/threat-model.mjs",
    "threat:check": "node scripts/threat-model.mjs --check",
    "build:distance": "bash scripts/build-distance.sh",
    "hooks:install": "bash scripts/hooks/install.sh",
    "test:audit": "RUN_AUDITS=1 vitest run src/tests/game/systems/{weaponMetaNone,weaponMetaLight,weaponMetaMedium,weaponMetaHeavy,weaponMetaHeadToHead,styleMatchups,armourStyleAudit,weaponFightSim,combatBalanceAudit,buildFitAudit,t4WeaponAudit,maimTargeting,carryCapacityAudit,weaponPawnFitNone,weaponPawnFitMedium,weaponPawnFitHeavy,creatureMatchup0,creatureMatchup1,creatureMatchup2,creatureMatchup3,creatureMatchup4,creatureMatchup5,creatureMatchup6,creatureMatchup7}.test.ts",
    "check:types": "svelte-check --tsconfig ./tsconfig.json",
    "knip": "knip --no-progress --include dependencies,unlisted,unresolved",
    "dupes": "jscpd src",
    "knip:all": "knip --no-progress"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@firefox-devtools/profiler-cli": "^0.2.1",
    "@sveltejs/adapter-auto": "^6.0.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.16.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/howler": "^2.2.13",
    "@types/node": "^22.20.0",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "electron": "^42.4.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-svelte": "^3.10.1",
    "globals": "^16.5.0",
    "jscpd": "^5.1.2",
    "knip": "^6.34.0",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "svelte-eslint-parser": "^1.8.1",
    "typescript": "^5.0.0",
    "vite": "^6.2.6",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "howler": "^2.2.4",
    "simplex-noise": "^4.0.3"
  }
}
