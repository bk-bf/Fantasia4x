    {
        "id": "hit_precision",
        "category": "combat",
        "primaryStat": "dexterity",
        "formula": "clamp(0.045 × (APT / 0.85) ** 5, 0.03, 0.22) × consciousness × sight",
        "description": "chance per landed blow to strike true — a telling hit that finds a gap (an eye, the throat, a soft belly) instead of glancing off (× consciousness × sight); weapons add their own bonus on top"
    },
    {
        "id"         : "melee_damage",
        "category"   : "combat",
        "primaryStat": "strength",
        "formula"    : "(1.0 + (POWER − 10) × 0.1) × manipulation",
        "description": "melee attack damage multiplier — the force the body can put behind a blow, and the hands that must still be whole to deliver it (× manipulation). Which core stat supplies that force is the weapon's: a two-hander is driven by strength, a one-hander placed by dexterity, a thrust by perception, a staff by intelligence. Breaking ARMOUR is its own stat (armor_damage); ranged damage is ranged_damage."
    },
    {
        "id"         : "armor_damage",
        "category"   : "combat",
        "primaryStat": "strength",
        "formula"    : "APT × manipulation",
        "description": "armour-breaking multiplier, how fast your blows wreck a foe's ARMOUR condition, SEPARATE from the flesh damage you deal through it (× manipulation). strength drives the force. Armour lost per landed hit = weapon.armorDamage × this: a hammer caves plate in a few blows, a mace dents it, a cleaver's edge barely scratches it (made to open flesh, not crack steel). Wreck the armour, then later blows land clean."
    },
