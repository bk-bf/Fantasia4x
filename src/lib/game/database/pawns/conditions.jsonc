                "color"      : "#C04030",
                "modifiers"  : {"strength": 0.55, "dexterity": 0.5, "workEfficiency": 0.65, "dodge": 0.65, "attackSpeed": 0.775, "hitChance": 0.8}
            }
        ]
    },
