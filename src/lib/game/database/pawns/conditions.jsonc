[
    {
        "id": "laden",
        "name": "Laden",
        "flags": ["physical", "load"],
        "description": "Gear enough to notice. The legs and the pace are untroubled; it is the fast work that suffers, a guard recovered a beat late, a step aside that costs more than it should.",
        "lethalSeverity": 99,
        "stages": [
            {
                "label"      : "settled weight",
                "minSeverity": 0.0,
                "color"      : "#9FA88C",
                "modifiers"  : {"dodge": 0.97, "attackSpeed": 0.99}
            },
            {
                "label"      : "laden",
                "minSeverity": 0.5,
                "color"      : "#C0A868",
                "modifiers"  : {"dodge": 0.91, "attackSpeed": 0.96, "hitChance": 0.98}
            }
        ]
    },
    {
        "id": "encumbered",
        "name": "Encumbered",
        "flags": ["physical", "load"],
        "description": "Carrying more than the body comfortably bears, worn armour plus pack weight against a strength-scaled limit. Slows movement, wrecks evasion and aim, and tires the body faster. Overload is allowed, at a price: strength and bags (belt/back) raise the limit, armour eats most of it. Severity = load ÷ capacity (driven directly, not over time).",
        "lethalSeverity": 99,
        "stages": [
            {
                "label"      : "burdened",
                "minSeverity": 0.0,
                "color"      : "#C8A064",
                "modifiers"  : {"dexterity": 0.9, "moveSpeed": 0.95, "fatigueRate": 1.1, "dodge": 0.93, "attackSpeed": 0.955, "hitChance": 0.96}
            },
            {
                "label"      : "encumbered",
                "minSeverity": 0.33,
                "color"      : "#D08040",
                "modifiers"  : {
