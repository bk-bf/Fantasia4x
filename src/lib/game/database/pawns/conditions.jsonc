            },
            {
                "label"      : "overloaded",
                "minSeverity": 0.83,
                "color"      : "#C04030",
                "modifiers"  : {
                    "dexterity"     : 0.45,
                    "strength"      : 0.75,
                    "moveSpeed"     : 0.6 ,
                    "workEfficiency": 0.6 ,
                    "fatigueRate"   : 1.6, "dodge": 0.615, "attackSpeed": 0.753, "hitChance": 0.78}
            }
        ]
    },
    {
        "id": "overmatched",
        "name": "Overmatched",
        "flags": ["physical", "weapon"],
        "description": "Straining to control a weapon heavier than the body can master — a crude orc slab in a mortal grip. Swings go wide, blows land soft, and the effort drains fast; only raw muscle tames such a thing. Severity = how far the wielder's strength falls short of the weapon's (driven directly, not over time).",
        "lethalSeverity": 99,
        "stages": [
            {
                "label"      : "unwieldy",
                "minSeverity": 0.0,
                "color"      : "#C8A064",
                "modifiers"  : {"hitChance": 0.85, "strength": 0.95, "fatigueRate": 1.25}
            },
            {
                "label"      : "overmatched",
                "minSeverity": 0.35,
                "color"      : "#D08040",
                "modifiers"  : {"hitChance": 0.68, "strength": 0.86, "dodge": 0.9, "fatigueRate": 1.5}
            },
            {
                "label"      : "flailing",
                "minSeverity": 0.7,
                "color"      : "#C04030",
                "modifiers"  : {"hitChance": 0.5, "strength": 0.75, "dodge": 0.8, "fatigueRate": 1.8}
            }
        ]
    },
    {
        "id": "windchilled",
        "name": "Windchilled",
        "mood": "cond_windchilled",
        "flags": ["environmental", "wind"],
        "charSpans": [ {"sheet": "font", "id": 126} ],
        "description": "Buffeted by the wind. Graded by how hard it's blowing, slightly windy barely registers, a gale claws at balance, aim and footing and tires the body out. Severity = the tile's effective wind (driven directly, not over time): a roof or the lee of a wall/mountain blocks most of it. On its own it only nags; in the cold it bites far harder, driving hypothermia faster (windchill).",
        "lethalSeverity": 99,
        "stages": [
            {
                "label"      : "slightly windy",
                "minSeverity": 0.0,
                "color"      : "#B0C4DE",
                "modifiers"  : {"dexterity": 0.98, "moveSpeed": 0.98, "hitChance": 0.992}
            },
            {
                "label"      : "somewhat windy",
                "minSeverity": 0.2,
                "color"      : "#A0B8D8",
                "modifiers"  : {"dexterity": 0.95, "moveSpeed": 0.95, "fatigueRate": 1.05, "hitChance": 0.98}
            },
            {
                "label"      : "fairly windy",
                "minSeverity": 0.4,
                "color"      : "#8FB0D4",
                "modifiers"  : {"dexterity": 0.9, "moveSpeed": 0.92, "workEfficiency": 0.95, "fatigueRate": 1.1, "hitChance": 0.96}
            },
            {
                "label"      : "very windy",
                "minSeverity": 0.6,
                "color"      : "#6FA0CC",
                "modifiers"  : {"dexterity": 0.82, "moveSpeed": 0.85, "workEfficiency": 0.88, "fatigueRate": 1.2, "hitChance": 0.928}
            },
            {
                "label"      : "extremely windy",
                "minSeverity": 0.8,
                "color"      : "#4F8FC4",
                "modifiers"  : {"dexterity": 0.72, "moveSpeed": 0.75, "workEfficiency": 0.78, "fatigueRate": 1.3, "hitChance": 0.888}
            }
        ]
    },
    {
        "id": "fractured",
        "audio": "fracture",
        "name": "Fractured Bone",
        "mood": "cond_fractured",
        "flags": ["injury", "bone"],
        "description": "A cracked or shattered bone, graded by how far the break has gone. Severity tracks the worst fracture on the body: a hairline crack nags, but a fully shattered bone (bone HP driven to 0) is agony that collapses strength and dexterity and crawls all work. The struck limb's own function, manipulation for an arm, movement for a leg, is gutted on top via the body model. The limb is NOT lost: bone mends over WEEKS of rest (dressing + a caretaker speed it).",
        "lethalSeverity": 99,
        "stages": [
            {
                "label"      : "hairline",
                "minSeverity": 0.0,
                "color"      : "#D8B048",
                "modifiers"  : {"strength": 0.9, "dexterity": 0.88, "workEfficiency": 0.9, "dodge": 0.916, "attackSpeed": 0.946, "hitChance": 0.952}
            },
            {
                "label"      : "cracked",
                "minSeverity": 0.4,
                "color"      : "#C8743A",
                "modifiers"  : {"strength": 0.75, "dexterity": 0.7, "workEfficiency": 0.8, "dodge": 0.79, "attackSpeed": 0.865, "hitChance": 0.88}
            },
            {
