// Pawn stat definitions. Work-category definitions live in Work.ts (WORK_CATEGORIES).
// "category" — UI grouping: "combat" | "physical" | "resistance" | "capacity" | "work" | "social"
// "formula"  — expression evaluated at runtime; tokens:
//                BRAWN AGILITY VIGOUR AWARENESS INTELLECT CHARISMA weight height  (base stats / physique)
//                consciousness manipulation sight moving blood_pumping blood_filtration
//                breathing digestion talking hearing pain  (body capacities, 0–1)
//                prestige  (standing from worn regalia — SocialService; 0 unadorned)
//                SKILL  (work stats only — WORK-EXPERIENCE: the pawn's experience-level base for
//                        that work category, levelBase(level 1–50) × the pawn's speed↔finesse
//                        style weight; see core/workExperience.ts. 1.0 for non-work formulas.)
//              Non-capacity formulas multiply by relevant capacities so limb damage
//              cascades into stat reduction. Example: dodge = (1.0 + (AGILITY−10)×0.02) × moving
//              clamp(x, lo, hi) is the one supported function (hard floors/caps, e.g. stealth's
//              AGILITY gate — zero below the floor, not merely small).
//              Work formulas: SKILL is the BASE; core stats are only a small tertiary supplement
//              (BRAWN+AGILITY → speed, INTELLECT+AWARENESS → yield, all four → quality; ≈ +0.27 max at stat 100).
[
    // ── Combat ────────────────────────────────────────────────────────────────────
    {
        // Was a flat `0.05 × APT`, which meant a superbly precise fighter chose its target on 6.1% of
        // landed blows against a poor one's 4.5% — a 1.6-point spread across the whole aptitude band,
        // so no build could ever be played toward finding a gap. The curve is now CONVEX in the roll:
        // anchored at the bottom of the band (0.045 at APT 0.85, i.e. unchanged), it reaches 0.20 at
        // the top — a top-precision fighter picks where the blow goes on one landed hit in five, and a
        // poor one gains nothing. `** 5` is the exponent that maps the band onto exactly that range;
        // `/ 0.85` is the anchor, so the low end pivots rather than shifts. Clamped because traits can
        // push the aptitude past the roll band and the curve is steep out there.
        "id": "hit_precision",
        "category": "combat",
        "primaryStat": "agility",
        "formula": "clamp(0.045 × (APT / 0.85) ** 5, 0.03, 0.22) × consciousness × sight",
        "description": "chance per landed blow to strike true — a telling hit that finds a gap (an eye, the throat, a soft belly) instead of glancing off (× consciousness × sight); weapons add their own bonus on top"
    },
    {
        "id"         : "melee_damage",
        "category"   : "combat",
        "primaryStat": "brawn",
        "formula"    : "(1.0 + (POWER − 10) × 0.1) × manipulation",
        "description": "melee attack damage multiplier — the force the body can put behind a blow, and the hands that must still be whole to deliver it (× manipulation). Which core stat supplies that force is the weapon's: a two-hander is driven by brawn, a one-hander placed by agility, a thrust by awareness, a staff by intellect. Breaking ARMOUR is its own stat (armor_damage); ranged damage is ranged_damage."
    },
    {
        "id"         : "armor_damage",
        "category"   : "combat",
        "primaryStat": "brawn",
        "formula"    : "APT × manipulation",
        "description": "armour-breaking multiplier, how fast your blows wreck a foe's ARMOUR condition, SEPARATE from the flesh damage you deal through it (× manipulation). brawn drives the force. Armour lost per landed hit = weapon.armorDamage × this: a hammer caves plate in a few blows, a mace dents it, a cleaver's edge barely scratches it (made to open flesh, not crack steel). Wreck the armour, then later blows land clean."
    },
    {
        "id"         : "hit_chance",
        "category"   : "combat",
        "primaryStat": "agility",
        "formula"    : "APT × sight × manipulation",
        "description": "attack accuracy (× sight × manipulation)"
    },
    {
        "id"         : "dodge",
        "category"   : "combat",
        "primaryStat": "agility",
        "formula"    : "(APT − (weight − 70) × 0.002) × moving",
        "description": "evasion (× moving; heavier = harder to dodge)"
    },
    {
        // The other negation axis (Combat.blockChance): a CHANCE (0–1) to fully stop a melee blow,
        // NOT weight-penalized (heavier braces BETTER — opposite of dodge) and never × moving, so a
        // plate-and-shield tank negates even when it can't dodge. Bare-handed this is small; a shield's
        // `blockBonus` is the bulk of it. Halved vs ranged. Clamped to the cap in Combat.
        //
        // Was `0.03 + (VIGOUR − 10) × 0.006`, which made block a THIRD thing a core stat bought, the
        // exact convergence the two-axis split exists to stop — and reading a raw stat as a skill is
        // what it is: catching a blow on a shield is training, not constitution. Now the skill half is
        // an APT roll like dodge, and the two things that genuinely are physical (frame, shield) stay.
        // 0.06 is the old curve's value at the median rolled vigour, so the median pawn is unchanged.
        "id"         : "block",
        "category"   : "combat",
        "primaryStat": "vigour",
        "formula"    : "0.06 × APT + (weight − 70) × 0.0015",
        "description": "block chance (body mass; a shield adds the bulk of it)"
    },
    {
        // STEALTH base (Layer A): sizeFactor (weight, dominant) × agilityGate (hard zero below AGILITY 8)
        // × moving. Traits/part grants/armour stealthMod layer on top in core/stealth.ts (Layer B),
        // folded in by evaluateStat — so reading this stat gives the FULL stealth value.
        "id"         : "stealth",
        "category"   : "combat",
        "primaryStat": "agility",
        "formula"    : "clamp(1 + (70 − weight) × 0.015, 0.2, 2.2) × clamp((AGILITY − 8) × 0.1, 0.0, 1.4) × moving",
        "description": "how easily the body goes unnoticed — a small, deft, sound-footed frame slips a watch that a big or clumsy one never could (× moving; a bad leg gives you away). Armour and a heavy tread cost it."
    },
    {
        "id"         : "knockdown_resistance",
        "category"   : "combat",
        "primaryStat": "vigour",
        "formula"    : "(1.0 + (VIGOUR − 10) × 0.025) × consciousness",
        "description": "resistance to stagger (× consciousness; dazed = easier to knock down)"
    },
    // vision_range was deleted (COMBAT-BALANCE task 6): nothing read it. Sight range is
    // core/vision.baseVisionRange — round(4 + awareness × 1.3) TILES, shared by pawns and mobs.
    {
        "id"         : "attack_speed",
        "category"   : "combat",
        "primaryStat": "agility",
        "formula"    : "APT × manipulation",
        "description": "attack cadence multiplier, higher = faster strikes (× manipulation, × the equipped weapon's own attackSpeed — a light blade darts, a heavy maul swings slow)"
    },
    // ── Ranged — AWARENESS = precision axis (aim_accuracy + aim_range), AGILITY = speed axis (aim_speed +
    //    reload_speed); BRAWN is melee/throw power only, never an aiming stat.
    {
        "id": "aim_accuracy",
        "category": "combat",
        "primaryStat": "awareness",
        "formula": "APT × sight × manipulation",
        "description": "ranged hit accuracy, the awareness PRECISION axis (deadeye), × sight × manipulation; Combat adds a LINEAR distance penalty + gear/ammo aimBonuses. The sniper stat, pairs with aim_range."
    },
    {
        "id": "aim_speed",
        "category": "combat",
        "primaryStat": "agility",
        "formula": "(1.0 + (AGILITY − 10) × 0.04) × manipulation",
        "description": "ranged AIM cadence, the agility SPEED axis (quick hands → fast loose), × manipulation. The shot gap is AIM time (this, lengthened by distance, far targets take longer to line up) PLUS span time (reload_speed, crossbows only); both shorten it. A ready quiver + bracers speed the aim further. The skirmisher/sling stat."
    },
    {
        "id": "reload_speed",
        "category": "combat",
        "primaryStat": "agility",
        "formula": "(1.0 + (AGILITY − 10) × 0.03) × manipulation",
        "description": "ranged RELOAD/spanning cadence, agility works the crossbow's windlass/lever fast, × manipulation. Only weapons with a mechanical reload (crossbows) have a span step, so it's a crossbow stat: interval = aim time (aim_speed) + span time (reload_speed). Bows/slings have no span → unaffected. Same agility SPEED axis as aim_speed, a deft shooter cycles a crossbow fast."
    },
    {
        "id": "aim_range",
        "category": "combat",
        "primaryStat": "awareness",
        "formula": "(1.0 + (AWARENESS − 10) × 0.025) × sight",
        "description": "ranged reach multiplier, the awareness PRECISION axis (a sharp eye sights + holds a far mark), × sight; scales the weapon's base range, capped by visionRange (effectiveRange = min(vision, weaponRange × aim_range + gear)). The sniper stat, pairs with aim_accuracy."
    },
    {
        "id": "ranged_damage",
        "category": "combat",
        "primaryStat": "brawn",
        "formula": "(1.0 + (POWER − 10) × 0.1) × manipulation",
        "description": "ranged attack damage multiplier — the draw or throw behind a shot, and the hands that hold it steady (× manipulation). A bow's draw-weight and a thrown weapon's force scale with it (ammo damage × weapon drawPower × this). Crossbows & slings are MECHANICAL, they ignore it (the stock/cord does the work)."
    },
    {
        "id": "heal_rate",
        "category": "physical",
        "primaryStat": "vigour",
        "formula": "(1.0 + (VIGOUR − 10) × 0.05) × blood_filtration",
        "description": "wound recovery speed multiplier (× blood_filtration, kidneys drive recovery; NOT × consciousness: an unconscious body still knits, often harder). Boosted further by rest, food, and mood"
    },
    // WORK-EXPERIENCE: the old `medical_skill` physical stat is gone — tend quality now rides the
    // caretaking WORK skill (`caretaking_quality` below, level-driven like every other craft).
    // ── Physical ──────────────────────────────────────────────────────────────────
    {
        "id"         : "movement_speed",
        "category"   : "physical",
        "primaryStat": "agility",
        "formula"    : "(1.0 + (AGILITY − 10) × 0.05 − (weight − 70) × 0.003 + (height − 170) × 0.001) × moving",
        "description": "movement speed (× moving; broken legs = crawl)"
    },
    {
        "id"         : "stamina",
        "category"   : "physical",
        "primaryStat": "vigour",
        "formula"    : "(50 + (VIGOUR − 10) × 4 + (AGILITY − 10) × 2) × moving × blood_pumping",
        "description": "stamina pool (× moving × blood_pumping)"
    },
    {
        "id": "stamina_recovery_rate",
        "category": "physical",
        "primaryStat": "vigour",
        "formula": "(2 + (VIGOUR − 10) × 0.15) × blood_filtration × blood_pumping",
        "description": "stamina recovered PER SECOND while resting/winded (scaled to ticks by Combat.tickStaminaAndWinded; × blood_filtration × blood_pumping; injury slows it). ~2/s at vigour 10 → a ~50 pool refills in ~25s; in-fight regen (×0.2) trails the ~2/s attack drain so long fights wind you (N-2 tuning dial). Fatigue divides this (up to ÷1.3 at fatigue 100) and multiplies attack stamina drain, so anything that raises fatigue, weather fatigueMul, conditions, indirectly saps stamina without double counting"
    },
    {
        "id"         : "blood_volume",
        "category"   : "physical",
        "primaryStat": "vigour",
        "formula"    : "weight × 1.4 + (VIGOUR − 10) × 2",
        "description": "total blood pool, physical property, not capacity-dependent"
    },
    {
        "id"         : "blood_regeneration",
        "category"   : "physical",
        "primaryStat": "vigour",
        "formula"    : "(1.0 + (VIGOUR − 10) × 0.08) × blood_filtration",
        "description": "blood recovery (× blood_filtration)"
    },
    {
        "id"         : "blood_clotting",
        "category"   : "physical",
        "primaryStat": "vigour",
        "formula"    : "(1.0 + (VIGOUR − 10) × 0.05) × blood_filtration",
        "description": "clotting ability, scales the per-roll chance a bleeding wound stops on its own (a lucky natural clot rolled ~every 3 in-game hours; × blood_filtration). A wound needs as many successful clots as its severity (minor 1, serious 2, critical+ 3); each cuts the bleed proportionally. A higher-vigour pawn is likelier to clot before bleeding out, but dressing the wound (caretaking) is the reliable stop. Mirrors heal_rate as the recovery-axis counterpart."
    },
    {
        "id": "hunger_rate",
        "category": "physical",
        "primaryStat": "vigour",
        "formula": "1.0 + (weight − 70) × 0.01",
        "description": "hunger accrual multiplier by body size (70 kg = 1.0×; bigger bodies hunger faster). Scaled at runtime by work, heat/weather and conditions (malnutrition, infection…)"
    },
    {
        "id": "fatigue_rate",
        "category": "physical",
        "primaryStat": "vigour",
        "formula": "1.0 − (VIGOUR − 10) × 0.02",
        "description": "fatigue accrual multiplier by fitness (vigour 10 = 1.0×; fitter pawns tire slower). The base rate everything multiplies, scaled at runtime by work/combat, cold weather + night, and conditions (dehydration, hypothermia…)"
    },
    {
        "id": "carry_weight",
        "category": "capacity",
        "primaryStat": "brawn",
        // Computed in ItemService.getCarryCapacityBreakdown (body mass + gear), not the formula engine.
        "carryLoadPerBrawn": 0.012,
        "carryLoadMin": 0.05,
        "carryLoadMax": 0.30,
        "formula": "bodyWeight × clamp(BRAWN × carryLoadPerBrawn, carryLoadMin, carryLoadMax)",
        "description": "maximum carry weight in kg, a brawn-scaled fraction of body mass (brawn 10 ≈ 12%)"
    },
    {
        "id"              : "carry_volume",
        "category"        : "capacity",
        "primaryStat"     : "vigour",
        // Also computed in ItemService.getCarryCapacityBreakdown, not the formula engine.
        "carryVolumePerKg": 0.13,
        "formula"         : "bodyWeight × carryVolumePerKg",
        "description"     : "maximum carry volume in litres, a fixed fraction of body mass (frame bulk)"
    },
    // ── Resistance ────────────────────────────────────────────────────────────────
    {
        "id"         : "cutting_resistance",
        "category"   : "resistance",
        "primaryStat": "agility",
        "formula"    : "(0.0 + (AGILITY − 10) × 0.01)",
        "description": "cutting damage reduction, innate (stat-only, not dimmed by a daze)"
    },
    {
        "id"         : "piercing_resistance",
        "category"   : "resistance",
        "primaryStat": "vigour",
        "formula"    : "(0.0 + (VIGOUR − 10) × 0.008)",
        "description": "piercing damage reduction, innate (stat-only, not dimmed by a daze)"
    },
    {
        "id"         : "blunt_resistance",
        "category"   : "resistance",
        "primaryStat": "vigour",
        "formula"    : "(0.0 + (VIGOUR − 10) × 0.008 + (BRAWN − 10) × 0.004)",
        "description": "blunt damage reduction, innate (stat-only, not dimmed by a daze)"
    },
    {
        "id": "fire_resistance",
        "category": "resistance",
        "primaryStat": "vigour",
        "formula": "(0.0 + (VIGOUR − 10) × 0.01)",
        "description": "fire damage reduction, innate (stat-only); also slows HEAT-STROKE onset from hot weather/temperature (SEASONS_WEATHER), reduces heat exposure before the condition driver"
    },
    {
        "id": "cold_resistance",
        "category": "resistance",
        "primaryStat": "vigour",
        "formula": "(0.0 + (VIGOUR − 10) × 0.01)",
        "description": "cold damage reduction, innate (stat-only); also slows HYPOTHERMIA onset from cold weather/temperature (SEASONS_WEATHER), reduces cold exposure before the condition driver"
    },
    {
        "id": "wetness_resistance",
        "category": "resistance",
        "primaryStat": "vigour",
        "formula": "(0.0 + (VIGOUR − 10) × 0.015)",
        "description": "how well the body sheds water (fur/hide/fitness), innate (stat-only). Does NOT change the `wet` onset (a full 100 meter, same for all); it slows how FAST the wetness meter FILLS on wet ground, so a hardy/woolly creature soaks slower and a frail one fast (SEASONS_WEATHER)"
    },
    {
        "id"         : "lightning_resistance",
        "category"   : "resistance",
        "primaryStat": "agility",
        "formula"    : "(0.0 + (AGILITY − 10) × 0.01)",
        "description": "lightning damage reduction, innate (stat-only, not dimmed by a daze)"
    },
    {
        "id"         : "shadow_resistance",
        "category"   : "resistance",
        "primaryStat": "intellect",
        "formula"    : "(0.0 + (INTELLECT − 10) × 0.01)",
        "description": "shadow damage reduction, innate (stat-only, not dimmed by a daze)"
    },
    {
        "id"         : "poison_resistance",
        "category"   : "resistance",
        "primaryStat": "vigour",
        "formula"    : "(0.0 + (VIGOUR − 10) × 0.015) × blood_filtration",
        "description": "toxin mitigation (× blood_filtration, kidneys/liver clear toxins; not dimmed by a daze)"
    },
    {
        "id"         : "disease_resistance",
        "category"   : "resistance",
        "primaryStat": "vigour",
        "formula"    : "(0.0 + (VIGOUR − 10) × 0.01) × blood_filtration",
        "description": "disease resistance (× blood_filtration, organ-based immune clearance; not dimmed by a daze)"
    },
    {
        "id"         : "mental_resistance",
        "category"   : "resistance",
        "primaryStat": "intellect",
        "formula"    : "(0.0 + (INTELLECT − 10) × 0.015) × consciousness",
        "description": "mental resistance (× consciousness)"
    },
    // ── Work ──────────────────────────────────────────────────────────────────────
    // Per work type: speed (completion rate), yield (amount per completion), quality (output grade).
    {
        "id"         : "foraging_speed",
        "category"   : "work",
        "primaryStat": "awareness",
        "formula"    : "SKILL × (1.0 + (BRAWN − 10) × 0.0015 + (AGILITY − 10) × 0.0015) × ((sight + moving) / 2)",
        "description": "foraging work speed (× ((sight + moving) / 2))"
    },
    {
        "id"         : "foraging_yield",
        "category"   : "work",
        "primaryStat": "awareness",
        "formula"    : "SKILL × (1.0 + (INTELLECT − 10) × 0.0015 + (AWARENESS − 10) × 0.0015) × sight",
        "description": "foraging resource amount (× sight)"
    },
    {
        "id"         : "woodcutting_speed",
        "category"   : "work",
        "primaryStat": "brawn",
        "formula"    : "SKILL × (1.0 + (BRAWN − 10) × 0.0015 + (AGILITY − 10) × 0.0015) × ((manipulation + moving) / 2)",
        "description": "woodcutting speed (× ((manipulation + moving) / 2))"
    },
    {
        "id"         : "woodcutting_yield",
        "category"   : "work",
        "primaryStat": "brawn",
        "formula"    : "SKILL × (1.0 + (INTELLECT − 10) × 0.0015 + (AWARENESS − 10) × 0.0015) × manipulation",
        "description": "wood per tree (× manipulation)"
    },
    {
        "id"         : "mining_speed",
        "category"   : "work",
        "primaryStat": "brawn",
        "formula"    : "SKILL × (1.0 + (BRAWN − 10) × 0.0015 + (AGILITY − 10) × 0.0015) × ((manipulation + moving) / 2)",
        "description": "mining speed (× ((manipulation + moving) / 2))"
    },
    {
        "id"         : "mining_yield",
        "category"   : "work",
        "primaryStat": "brawn",
        "formula"    : "SKILL × (1.0 + (INTELLECT − 10) × 0.0015 + (AWARENESS − 10) × 0.0015) × manipulation",
        "description": "ore per vein (× manipulation)"
    },
    // Deliberately NO `hunting_speed`/`_yield`/`_quality`: hunting is NOT a work skill — the task is
    // mark quarry → walk → fight it as normal combat → haul the carcass. It has no work formula and
    // no experience level. In the work grid it's excluded from the best/weakest medal ranking
    // (workUtils.NON_SKILL_TASKS) and its tooltip lists the driving combat stats instead of a speed.
    {
        "id"         : "butchery_speed",
        "category"   : "work",
        "primaryStat": "brawn",
        "formula"    : "SKILL × (1.0 + (BRAWN − 10) × 0.0015 + (AGILITY − 10) × 0.0015) × manipulation",
        "description": "butchery speed (× manipulation)"
    },
    {
        "id"         : "butchery_yield",
        "category"   : "work",
        "primaryStat": "brawn",
        "formula"    : "SKILL × (1.0 + (INTELLECT − 10) × 0.0015 + (AWARENESS − 10) × 0.0015) × manipulation",
        "description": "meat per carcass (× manipulation)"
    },
    {
        "id"         : "butchery_quality",
        "category"   : "work",
        "primaryStat": "agility",
        "formula"    : "SKILL × (1.0 + (BRAWN − 10) × 0.0007 + (AGILITY − 10) × 0.0007 + (INTELLECT − 10) × 0.0007 + (AWARENESS − 10) × 0.0007) × ((manipulation + sight) / 2)",
        "description": "cut quality (× ((manipulation + sight) / 2))"
    },
    {
        "id"         : "fishing_speed",
        "category"   : "work",
        "primaryStat": "agility",
        "formula"    : "SKILL × (1.0 + (BRAWN − 10) × 0.0015 + (AGILITY − 10) × 0.0015) × ((sight + manipulation) / 2)",
        "description": "fishing speed (× ((sight + manipulation) / 2))"
    },
    {
        "id"         : "fishing_yield",
        "category"   : "work",
        "primaryStat": "agility",
        "formula"    : "SKILL × (1.0 + (INTELLECT − 10) × 0.0015 + (AWARENESS − 10) × 0.0015) × sight",
        "description": "catch size (× sight)"
    },
    {
        "id"         : "crafting_speed",
        "category"   : "work",
        "primaryStat": "agility",
        "formula"    : "SKILL × (1.0 + (BRAWN − 10) × 0.0015 + (AGILITY − 10) × 0.0015) × ((manipulation + sight) / 2)",
        "description": "crafting speed (× ((manipulation + sight) / 2))"
    },
    {
        "id"         : "crafting_quality",
        "category"   : "work",
        "primaryStat": "agility",
        "formula"    : "SKILL × (1.0 + (BRAWN − 10) × 0.0007 + (AGILITY − 10) × 0.0007 + (INTELLECT − 10) × 0.0007 + (AWARENESS − 10) × 0.0007) × ((manipulation + sight + consciousness) / 3)",
        "description": "item quality (× ((manipulation + sight + consciousness) / 3))"
    },
    {
        "id"         : "metalworking_speed",
        "category"   : "work",
        "primaryStat": "brawn",
        "formula"    : "SKILL × (1.0 + (BRAWN − 10) × 0.0015 + (AGILITY − 10) × 0.0015) × ((manipulation + sight) / 2)",
        "description": "smithing speed (× ((manipulation + sight) / 2))"
    },
    {
        "id"         : "metalworking_quality",
        "category"   : "work",
        "primaryStat": "intellect",
        "formula"    : "SKILL × (1.0 + (BRAWN − 10) × 0.0007 + (AGILITY − 10) × 0.0007 + (INTELLECT − 10) × 0.0007 + (AWARENESS − 10) × 0.0007) × ((manipulation + sight + consciousness) / 3)",
        "description": "metal purity / edge retention (× ((manipulation + sight + consciousness) / 3))"
    },
    {
        "id"         : "leatherworking_speed",
        "category"   : "work",
        "primaryStat": "agility",
        "formula"    : "SKILL × (1.0 + (BRAWN − 10) × 0.0015 + (AGILITY − 10) × 0.0015) × ((manipulation + sight) / 2)",
        "description": "leatherwork speed (× ((manipulation + sight) / 2))"
    },
    {
        "id"         : "leatherworking_quality",
        "category"   : "work",
        "primaryStat": "agility",
        "formula"    : "SKILL × (1.0 + (BRAWN − 10) × 0.0007 + (AGILITY − 10) × 0.0007 + (INTELLECT − 10) × 0.0007 + (AWARENESS − 10) × 0.0007) × ((manipulation + sight) / 2)",
        "description": "leather quality (× ((manipulation + sight) / 2))"
    },
    // ── Tailoring PARENT (soft goods): fallback for the Weaving leaf; Leatherwork has its own above.
    {
        "id"         : "tailoring_speed",
        "category"   : "work",
        "primaryStat": "agility",
        "formula"    : "SKILL × (1.0 + (BRAWN − 10) × 0.0015 + (AGILITY − 10) × 0.0015) × ((manipulation + sight) / 2)",
        "description": "soft-goods work speed (× ((manipulation + sight) / 2))"
    },
    {
        "id"         : "tailoring_quality",
        "category"   : "work",
        "primaryStat": "agility",
        "formula"    : "SKILL × (1.0 + (BRAWN − 10) × 0.0007 + (AGILITY − 10) × 0.0007 + (INTELLECT − 10) × 0.0007 + (AWARENESS − 10) × 0.0007) × ((manipulation + sight) / 2)",
        "description": "cloth / garment quality (× ((manipulation + sight) / 2))"
    },
    // ── Woodworking (carpentry): planks, furniture, hafts.
    {
        "id"         : "woodworking_speed",
