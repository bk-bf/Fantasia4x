    {
        "id"         : "beauty",
        "category"   : "social",
        "primaryStat": "charisma",
        "formula"    : "(0.4 + 0.6 × intact) × (1.0 + (CHARISMA − 10) × 0.04)",
        "description": "the face and bearing the world sees before a word is spoken; charm brightens it, and every scar and missing piece takes its toll"
    },
    // SOCIAL-LAYER §6: the lazily-computed `prestige` token surfaced as its own readout — inherent
