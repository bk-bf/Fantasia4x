{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/routes/**/+*.{ts,js,svelte}",
    "src/app.html",
    "electron/**/*.{cjs,js}",
    "tools/ci/*.mjs",
    "tools/claude/*.mjs",
    "tools/lib/private-check.mjs",
    "tools/work-pins/*.mjs",
    "tools/gpu/*.mjs",
    "tools/*.mjs",
    "tools/dev-tools/**/*.mjs",
    "src/tests/**/*.test.ts"
  ],
  "project": [
    "src/**/*.{ts,js,svelte}",
    "tools/**/*.mjs"
  ],
  "ignore": [
    ".claude/**",
    "src/lib/sim-core-pkg/**",
    "src/lib/spatial-core-pkg/**",
    "tools/dev-shell/**",
    "build-resources/**"
  ],
  "ignoreDependencies": [
    "@firefox-devtools/profiler-cli",
    "@sveltejs/adapter-auto",
    "svelte-check"
  ],
  "ignoreExportsUsedInFile": true,
  "vitest": {
    "config": [
      "vitest.config.ts",
      "tools/bench/vitest.config.ts",
      "tools/bench/tps.config.ts",
      "tools/work-pins/vitest.config.ts"
    ]
  }
}
