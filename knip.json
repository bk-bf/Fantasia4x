{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/routes/**/+*.{ts,js,svelte}",
    "src/app.html",
    "electron/**/*.{cjs,js}",
    "tools/audit/*.mjs",
    "scripts/**/*.mjs",
    "src/tests/**/*.test.ts"
  ],
  "project": [
    "src/**/*.{ts,js,svelte}",
    "tools/**/*.mjs",
    "scripts/**/*.mjs"
  ],
  "ignore": [
    "src/lib/sim-core-pkg/**",
    "src/lib/spatial-core-pkg/**",
    "desktop-spike/**",
    "build-resources/**"
  ],
  "ignoreDependencies": [
    "@firefox-devtools/profiler-cli",
    "@sveltejs/adapter-auto"
  ],
  "ignoreExportsUsedInFile": true
}
