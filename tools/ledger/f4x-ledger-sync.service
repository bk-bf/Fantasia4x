[Unit]
Description=Fantasia4x playtesting ledger: pull spools and perf logs into the store
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@CHECKOUT@
ExecStartPre=-/usr/bin/git -C @CHECKOUT@ pull --ff-only --quiet
ExecStart=/usr/bin/env node @CHECKOUT@/tools/ledger/cli.mjs sync
TimeoutStartSec=45min
Nice=10
IOSchedulingClass=idle
