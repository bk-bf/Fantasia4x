[Unit]
Description=GitHub Actions runner %i for bk-bf/Fantasia4x
After=network-online.target

[Service]
WorkingDirectory=@REPO@/.ci/runners/%i
ExecStartPre=/usr/bin/mkdir -p @REPO@/.ci/runners/%i/tmp
ExecStartPre=/usr/bin/find @REPO@/.ci/runners/%i/tmp -mindepth 1 -delete
ExecStart=@REPO@/.ci/runners/%i/run.sh
Restart=always
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=300
Environment=HOME=@REPO@/.ci/runners/%i/home
Environment=XDG_CACHE_HOME=@REPO@/.ci/runners/%i/home/.cache
Environment=XDG_DATA_HOME=@REPO@/.ci/runners/%i/home/.local/share
Environment=XDG_CONFIG_HOME=@REPO@/.ci/runners/%i/home/.config
Environment=TMPDIR=@REPO@/.ci/runners/%i/tmp
Environment=pnpm_config_store_dir=%h/.local/share/pnpm/store
Environment=pnpm_config_cache_dir=%h/.cache/pnpm
Environment=ACTIONS_RUNNER_HOOK_JOB_STARTED=@REPO@/.ci/runners/%i/gate.sh
Environment=PLAYWRIGHT_BROWSERS_PATH=%h/.cache/ms-playwright
MemoryHigh=8G

[Install]
WantedBy=default.target
