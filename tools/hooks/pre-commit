#!/usr/bin/env bash
ROOT="$(git rev-parse --show-toplevel)"
if [[ -f "$ROOT/tools/lib/private-check.mjs" && ! -f "$(git rev-parse --git-path MERGE_HEAD)" ]]; then
  git diff --cached -U0 --no-color | grep '^+' | grep -v '^+++' |
    node "$ROOT/tools/lib/private-check.mjs" "a staged line" || exit 1
fi
