#!/usr/bin/env bash
set -uo pipefail

ROOT="$(cd "$(git rev-parse --git-common-dir)/.." && pwd)"
TOP="$(git rev-parse --show-toplevel)"

NEW=()
BRANCHES=()
DEV=()
while read -r _local_ref local_sha remote_ref remote_sha; do
  [[ "$local_sha" =~ ^0+$ ]] && continue
  [[ "$remote_ref" == refs/heads/* ]] || continue
  BRANCHES+=("${remote_ref#refs/heads/}")
  [[ "$remote_ref" == refs/heads/dev ]] && DEV+=("$local_sha $remote_sha")
  [[ "$remote_sha" =~ ^0+$ ]] && NEW+=("${remote_ref#refs/heads/}")
done

if (( ${#BRANCHES[@]} )); then
  node --input-type=module -e "
import { blockProblem } from 'file://$ROOT/tools/audit/lib/blockers.mjs';
let refused = false;
for (const branch of process.argv.slice(1)) {
  try {
    const problem = blockProblem(branch);
    if (problem) {
      console.error('pre-push: ' + problem);
      refused = true;
    }
  } catch (e) {
    console.error('pre-push: could not read the blockers of ' + branch + ', pushing it anyway: ' + String(e.message).split('\n')[0]);
  }
}
process.exit(refused ? 1 : 0);
" "${BRANCHES[@]}" || exit 1
fi

if (( ${#NEW[@]} )); then
  node --input-type=module -e "
import { branchProblem } from 'file://$ROOT/tools/audit/lib/branch.mjs';
const bad = process.argv.slice(1).map(branchProblem).filter(Boolean);
if (bad.length) {
  for (const b of bad) console.error('pre-push: ' + b);
  console.error('  Rename it with: git branch -m <old> <new>. Bypass once with: git push --no-verify');
  process.exit(1);
}
" "${NEW[@]}" || exit 1
fi

HEAD_SHA="$(git rev-parse HEAD)"
for entry in "${DEV[@]}"; do
  sha="${entry% *}"
  before="${entry#* }"
  if [[ "$sha" != "$HEAD_SHA" ]]; then
    echo "pre-push: push dev from a checkout of the commit being pushed; the server runs the checked-out commit" >&2
    exit 1
  fi
  echo "pre-push: pnpm check and the tests related to the change since ${before:0:8}, on the server, before dev moves" >&2
  (cd "$TOP" && CHECK_BASE="$before" node tools/remote/run.mjs node tools/audit/ci-check.mjs) || {
    echo "pre-push: pnpm check or the related tests failed; dev is not pushed" >&2
    exit 1
  }
done

CARDS=()
for b in "${BRANCHES[@]}"; do [[ "$b" == dev ]] || CARDS+=("$b"); done
if (( ${#CARDS[@]} )); then
  node --input-type=module -e "
import { followBranch } from 'file://$ROOT/tools/audit/lib/board.mjs';
for (const branch of process.argv.slice(1)) {
  try {
    const r = followBranch(branch);
    if (r?.moved) console.error('pre-push: #' + r.n + ' ' + (r.from || 'no lane') + ' -> ' + r.to);
  } catch (e) {
    console.error('pre-push: the card of ' + branch + ' stayed put: ' + String(e.message).split('\n')[0]);
  }
}
" "${CARDS[@]}" || true
fi
