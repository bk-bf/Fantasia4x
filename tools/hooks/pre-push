#!/usr/bin/env bash
set -uo pipefail

ROOT="$(git rev-parse --show-toplevel)"

NEW=()
BRANCHES=()
CHANGED=""
MOCKUPS=""
while read -r _local_ref local_sha remote_ref remote_sha; do
  [[ "$local_sha" =~ ^0+$ ]] && continue
  [[ "$remote_ref" == refs/heads/* ]] || continue
  BRANCHES+=("${remote_ref#refs/heads/}")
  [[ "$remote_sha" =~ ^0+$ ]] && NEW+=("${remote_ref#refs/heads/}")
  if [[ "$remote_ref" == refs/heads/dev && ! "$remote_sha" =~ ^0+$ ]]; then
    base="$remote_sha"
    MOCKUPS+="$(git diff --name-only --diff-filter=d "$base" "$local_sha" -- mockups)"
  else
    base="$(git merge-base "$local_sha" origin/dev 2>/dev/null || true)"
  fi
  [[ -n "$base" ]] && CHANGED+="$(git diff --name-only --diff-filter=d "$base" "$local_sha")"$'\n'
done

if [[ -n "$MOCKUPS" ]]; then
  echo "pre-push: refused. dev takes no mockups; these belong on mockups/live:" >&2
  printf '%s\n' "$MOCKUPS" | head -10 | sed 's/^/  /' >&2
  echo "  Move the commits with: git rebase --onto origin/mockups/live origin/dev" >&2
  echo "  Then: git push origin HEAD:mockups/live. AGENTS.md, \"Mockups land on mockups/live\"." >&2
  exit 1
fi

if [[ -n "${CHANGED//[$'\n']/}" ]]; then
  printf '%s' "$CHANGED" | node --input-type=module -e "
import { readFileSync } from 'node:fs';
import { unmappedFiles, unmappedMessage } from 'file://$ROOT/tools/ci/ci-scope.mjs';
const files = [...new Set(readFileSync(0, 'utf8').split('\\n').filter(Boolean))];
const missing = unmappedFiles(files);
if (missing.length) {
  console.error('pre-push: refused. ' + unmappedMessage(missing));
  process.exit(1);
}
" || exit 1
fi

if (( ${#BRANCHES[@]} )); then
  node --input-type=module -e "
import { blockProblem } from 'file://$ROOT/tools/lib/blockers.mjs';
let refused = false;
for (const branch of process.argv.slice(1)) {
  try {
    const problem = blockProblem(branch);
    if (problem) {
      console.error('pre-push: ' + problem);
      refused = true;
    }
  } catch (e) {
    console.error('pre-push: could not read the blockers of ' + branch + ', pushing it anyway: ' + String(e.message).split('\n')[0]);
  }
}
process.exit(refused ? 1 : 0);
" "${BRANCHES[@]}" || exit 1
fi

if (( ${#NEW[@]} )); then
  node --input-type=module -e "
import { branchProblem } from 'file://$ROOT/tools/lib/branch.mjs';
const bad = process.argv.slice(1).map(branchProblem).filter(Boolean);
if (bad.length) {
  for (const b of bad) console.error('pre-push: ' + b);
  console.error('  Rename it with: git branch -m <old> <new>. Bypass once with: git push --no-verify');
  process.exit(1);
}
" "${NEW[@]}" || exit 1
fi

