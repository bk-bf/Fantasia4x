{
  "permissions": {
    "deny": [
      "Bash(gh issue create:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue close:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue reopen:*)",
      "Bash(gh label create:*)",
      "Bash(gh label edit:*)",
      "Bash(gh label delete:*)",
      "Bash(gh project item-edit:*)",
      "Bash(gh project item-delete:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/audit/hooks/inflight.mjs\" prompt",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/audit/hooks/inflight.mjs\" edit",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
